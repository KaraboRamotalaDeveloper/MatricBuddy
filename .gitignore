# -------------------------
# Dependencies
# -------------------------
node_modules/
client/node_modules/
server/node_modules/

# -------------------------
# Environment variables
# -------------------------
.env
.env.local
.env.development
.env.production
.env.test

client/.env
client/.env.local
client/.env.development
client/.env.production

server/.env
server/.env.local
server/.env.development
server/.env.production

# Keep example environment files
!.env.example
!client/.env.example
!server/.env.example

# -------------------------
# Build / production files
# -------------------------
dist/
build/
client/dist/
client/build/
server/dist/
server/build/

# -------------------------
# Vite
# -------------------------
.vite/

# -------------------------
# Logs
# -------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Operating system files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# IDE / Editor files
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# -------------------------
# Testing / coverage
# -------------------------
coverage/
.nyc_output/

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp

# -------------------------
# Uploaded files / local storage
# -------------------------
uploads/
server/uploads/
client/uploads/

# -------------------------
# Cache
# -------------------------
.cache/
.parcel-cache/
.eslintcache

# -------------------------
# Secrets / credentials
# -------------------------
*.pem
*.key
*.crt

